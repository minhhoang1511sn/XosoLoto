<Window x:Class="Xosoloto.PrizeDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prize Display" 
        WindowState="Maximized"
        WindowStyle="None">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.Background>
                <ImageBrush x:Name="imgBackground" Stretch="Fill" />
            </Grid.Background>

            <!-- ============================================================
                 Toạ độ dưới đây được ĐO TRỰC TIẾP (bằng phân tích pixel) từ ảnh
                 nền Images/DetailsPrize.png (dải ruy băng nhãn tên giải + khung
                 bo góc chứa số trúng thưởng), quy đổi sang hệ toạ độ canvas gốc
                 1920x1080. Dùng Canvas với vị trí TUYỆT ĐỐI để đảm bảo LUÔN khớp
                 đúng khung trong ảnh nền, không bị lệch dù màn hình nào.

                 Đo được (ảnh gốc 1344x768, scale X=1.4286 / Y=1.40625):
                   - Dải ruy băng nhãn: x 130→1225, y 419→605
                   - Khung số (bo góc): x 130→1225, y 605→975
            -->
            <Canvas Width="1920" Height="1080">
                <!-- Header: Logo + Title - đặt ngay dưới dải ruy băng nền (ruy băng
                     kết thúc ở khoảng y=115-170 tại điểm thấp nhất), không đè lên
                     chữ trên ruy băng. -->
                <Image x:Name="imgLogo" Height="110" Width="250"
                       Canvas.Left="100" Canvas.Top="200" Stretch="Uniform"/>
                <TextBlock x:Name="txtTitle"
                      Text="ĐẠI HỘI TẾT 2025"
                      FontSize="70"
                      FontWeight="Bold"
                      Foreground="#FFD700"
                      FontFamily="/Fonts/#HL-Thufap2-Unicode"
                      Canvas.Left="390"
                      Canvas.Top="200"
                      Height="110"
                      MaxWidth="1430"
                           TextAlignment="Center"
                      TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <SkewTransform AngleX="-5"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Nhãn tên giải ("LỘC XUÂN i" / "9 GIẢI KHUYẾN KHÍCH") - khớp đúng
                     dải ruy băng đỏ (brush stroke) phía trên khung số trong ảnh nền.
                     Đo được: x 130→1225, y 419→605 (cao 186px) -->
                <Border Canvas.Left="170"
        Canvas.Top="425"
        Width="1000"
        Height="170">
                    <TextBlock x:Name="txtPrizeName"
               Text="LỘC XUÂN"
               FontSize="70"
               FontWeight="ExtraBold"
               Foreground="White"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <!-- Số trúng thưởng - khớp đúng khung bo góc màu kem trong ảnh nền.
                     Đo được: x 130→1225, y 605→975 (cao 370px).
                     FontFamily khai báo rõ ràng để tránh WPF chọn nhầm font fallback
                     không có glyph "?" dạng outline (gây hiện tượng ô vuông đen nhỏ
                     không co giãn theo FontSize). -->
                <TextBox x:Name="txtPrizeNumber"
     Text="? ? ? ?"
     FontFamily="Segoe UI"
     FontSize="180"
     FontWeight="Black"

     AcceptsReturn="True"
     TextWrapping="Wrap"

     FocusVisualStyle="{x:Null}"
     SelectionBrush="Transparent"
     CaretBrush="Black"

     Background="Transparent"
     BorderThickness="0"
     Foreground="Black"

     Canvas.Left="150"
     Canvas.Top="615"
     Width="1055"
     Height="350"
     TextAlignment="Center">
                    <!-- ControlTemplate riêng: TextBox có AcceptsReturn="True" (multiline)
                         mặc định BỎ QUA VerticalContentAlignment="Center", luôn dính chữ
                         lên sát mép trên. Ghi đè template để Grid bọc ScrollViewer tự co
                         theo nội dung và canh giữa trong khung cao 350px. HorizontalAlignment
                         của ScrollViewer để "Stretch" (thay vì "Left") để ScrollViewer chiếm
                         trọn bề rộng 1055px, nhờ đó TextAlignment="Center" mới có khoảng
                         trống để canh chữ vào giữa theo chiều ngang. -->
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid VerticalAlignment="Center">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Ảnh giải thưởng - bên phải khung số (khung kết thúc ở x=1225),
                     canh giữa khoảng trống còn lại bên phải. -->
                <Viewbox Canvas.Left="1330" Canvas.Top="440" Width="480" Height="480">
                    <Image x:Name="imgPrize" Stretch="Uniform" MaxHeight="350" MaxWidth="350"/>
                </Viewbox>

                <Button x:Name="btnBack"
               Content="◄ Back"
               Canvas.Left="60"
               Canvas.Top="990"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"
               Background="#1E90FF"
               BorderBrush="#104E8B"
               BorderThickness="2"
               Padding="22,10"
               Cursor="Hand"
               Click="btnBack_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.6"/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BorderThickness="{TemplateBinding BorderThickness}"
                                       CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4169E1"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0047AB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Canvas>
        </Grid>
    </Viewbox>

</Window>
