<Window x:Class="Xosoloto.PrizeDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prize Display" 
        WindowState="Maximized"
        WindowStyle="None">
    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="imgBackground" ImageSource="Images/DetailsPrize.png" Stretch="Fill" />
        </Grid.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="imgLogo" Height="100" Width="220" Margin="20,0" Stretch="Uniform"/>
                <TextBlock x:Name="txtTitle" 
                           Text="ĐẠI HỘI TẾT 2025"
                           FontSize="60"
                           FontWeight="Bold"
                           Foreground="#FFD700"
                           VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <SkewTransform AngleX="-5"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="100,0,50,0">
                    <TextBlock x:Name="txtPrizeName" 
                               Text="LỘC XUÂN"
                               FontSize="70" 
                               FontWeight="ExtraBold"
                               Foreground="White"
                               Margin="0,0,0,20">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Border Background="#FFF8DC" CornerRadius="25" BorderBrush="#D2691E" BorderThickness="4">
                        <TextBlock x:Name="txtPrizeNumber" 
                                   Text="? ? ? ?"
                                   FontSize="160" 
                                   FontWeight="Black"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Padding="20"/>
                    </Border>
                </StackPanel>

                <Viewbox Grid.Column="1" Margin="20,50,100,50">
                    <Image x:Name="imgPrize" Stretch="Uniform"/>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</Window>