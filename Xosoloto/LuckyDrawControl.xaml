<Window x:Class="Xosoloto.LuckyDrawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Xosoloto"
        mc:Ignorable="d" 
        Title="Lucky Draw"
        Height="900" Width="1600"
        MinWidth="1200" MinHeight="700"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        x:Name="MainWindow"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" 
                          Color="Black" 
                          BlurRadius="10" 
                          ShadowDepth="3"
                          Opacity="0.8"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/backgroundlocxuan.png" Stretch="Fill" />
        </Grid.Background>

        <Canvas x:Name="MainCanvas">
            <!-- Logo - Góc trên trái (khung xanh 1) -->
            <Image x:Name="imgLogo" 
                   Height="110" 
                   Width="250"
                   Canvas.Left="90"
                   Canvas.Top="180"
                   Stretch="Fill"/>

            <!-- Title - Giữa trên cùng -->
            <TextBlock x:Name="txtTitle" 
                       Text="ĐẠI HỘI TẾT 2025"
                       FontSize="80"
                       FontWeight="Bold"
                       Foreground="#FFD700"
                       
                               FontFamily="/Fonts/#HL-Thufap2-Unicode"
                       Canvas.Top="100"
                       TextAlignment="Center"
                       Effect="{StaticResource TextShadow}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-5"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Prize Image - Bên trái giữa (khung xanh 2) -->
            <Image x:Name="imgPrize" 
                   Height="330" 
                   Width="330"
                   Canvas.Left="90"
                   Canvas.Top="300"
                   Stretch="Fill"/>

            <!-- Các ô số "Lộc Xuân i" và nút bấm được sinh ĐỘNG trong code-behind
                 theo đúng số vòng (số giải) đã cấu hình ở màn hình InitLocXuan,
                 xem LuckyDrawControl.xaml.cs -> BuildDynamicPrizeSlots(). -->
            <StackPanel x:Name="spButtons" Orientation="Horizontal"/>

        </Canvas>
    </Grid>
</Window>