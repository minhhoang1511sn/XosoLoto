<Window x:Class="Xosoloto.LuckyDrawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Xosoloto"
        mc:Ignorable="d" 
        Title="Lucky Draw"
        Height="900" Width="1600"
        MinWidth="1200" MinHeight="700"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        x:Name="MainWindow"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" 
                          Color="Black" 
                          BlurRadius="10" 
                          ShadowDepth="3"
                          Opacity="0.8"/>
    </Window.Resources>

    <!-- ============================================================
         RESPONSIVE LAYOUT: toàn bộ nội dung được vẽ trên 1 "canvas ảo"
         kích thước CỐ ĐỊNH 1600x900 (đúng bằng BASE_WIDTH/BASE_HEIGHT
         trong code-behind), sau đó Viewbox co giãn ĐỀU (Stretch="Uniform")
         khối này để vừa khít với kích thước cửa sổ/màn hình THỰC TẾ, dù
         lớn hay nhỏ, tỉ lệ nào. Nhờ vậy MỌI phần tử bên trong (logo, tiêu
         đề, ảnh giải, các ô số, nút bấm...) luôn giữ đúng vị trí tương đối
         với nhau và với ảnh nền — không còn tình trạng lệch vị trí do có
         phần tử "fix cứng" pixel còn phần khác lại tính theo tỉ lệ cửa sổ
         như trước đây. Không cần code-behind tự tính lại vị trí khi resize
         nữa (đã bỏ Window_SizeChanged/UpdatePositions kiểu cũ).
         ============================================================ -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900">
            <Grid.Background>
                <ImageBrush ImageSource="Images/backgroundlocxuan.png" Stretch="Fill" />
            </Grid.Background>

            <Canvas x:Name="MainCanvas" Width="1600" Height="900">
                <!-- Logo - Góc trên trái (khung xanh 1) -->
                <Image x:Name="imgLogo" 
                       Height="110" 
                       Width="250"
                       Canvas.Left="90"
                       Canvas.Top="180"
                       Stretch="Fill"/>

                <!-- Title - Giữa trên cùng. Bọc trong Viewbox kích thước CỐ ĐỊNH (khớp lề
                     90px với logo 2 bên), Stretch="Uniform" + StretchDirection="DownOnly":
                     tiêu đề ngắn giữ nguyên cỡ chữ 80, tiêu đề dài tự THU NHỎ vừa khung
                     (không còn bị tràn/lệch hay phải đo-canh-giữa thủ công bằng code-behind),
                     luôn canh giữa đúng và vừa khít trên MỌI kích thước màn hình vì Viewbox
                     ngoài cùng (bọc cả Grid 1600x900) đã co giãn đều toàn bộ khối này rồi. -->
                <Viewbox Canvas.Left="90" Canvas.Top="135" Width="1420" Height="120"
                         Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock x:Name="txtTitle" 
                               Text="ĐẠI HỘI TẾT 2025"
                               FontSize="80"
                               FontWeight="Bold"
                               Foreground="#FFD700"
                               FontFamily="/Fonts/#HL-Thufap2-Unicode"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Effect="{StaticResource TextShadow}">
                        <TextBlock.RenderTransform>
                            <SkewTransform AngleX="-5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Viewbox>

                <!-- Prize Image - Bên trái giữa (khung xanh 2) -->
                <Image x:Name="imgPrize" 
                       Height="330" 
                       Width="330"
                       Canvas.Left="90"
                       Canvas.Top="300"
                       Stretch="Fill"/>

                <!-- Các ô số "Lộc Xuân i" và nút bấm được sinh ĐỘNG trong code-behind
                     theo đúng số vòng (số giải) đã cấu hình ở màn hình InitLocXuan,
                     xem LuckyDrawControl.xaml.cs -> BuildDynamicPrizeSlots(). Vị trí của
                     chúng cũng được tính theo toạ độ CỐ ĐỊNH trên canvas 1600x900 (không
                     còn phụ thuộc ActualWidth/ActualHeight của cửa sổ). -->
                <StackPanel x:Name="spButtons" Orientation="Horizontal"
                            Canvas.Left="100" Canvas.Top="780"/>

                <Button x:Name="btnChangeGame"
                        Content="🔁 Đổi loại game"
                        Canvas.Right="20"
                        Canvas.Top="20"
                        Padding="10,5"
                        FontSize="14"
                        ToolTip="Thoát khỏi Lộc Xuân Đầu Năm, quay lại màn hình chọn loại game"
                        Click="btnChangeGame_Click"/>

            </Canvas>
        </Grid>
    </Viewbox>
</Window>