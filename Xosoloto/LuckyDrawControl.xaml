<Window x:Class="Xosoloto.LuckyDrawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Xosoloto"
        mc:Ignorable="d" 
        Title="Lucky Draw"
        Height="900" Width="1600"
        MinWidth="1200" MinHeight="700"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        x:Name="MainWindow"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" 
                          Color="Black" 
                          BlurRadius="10" 
                          ShadowDepth="3"
                          Opacity="0.8"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/backgroundlocxuan.png" Stretch="Fill" />
        </Grid.Background>

        <Canvas x:Name="MainCanvas">
            <!-- Logo - Góc trên trái (khung xanh 1) -->
            <Image x:Name="imgLogo" 
                   Height="110" 
                   Width="250"
                   Canvas.Left="90"
                   Canvas.Top="200"
                   Stretch="Fill"/>

            <!-- Title - Giữa trên cùng -->
            <TextBlock x:Name="txtTitle" 
                       Text="ĐẠI HỘI TẾT 2025"
                       FontSize="60"
                       FontWeight="Bold"
                       Foreground="#FFD700"
                       Canvas.Top="170"
                       TextAlignment="Center"
                       Effect="{StaticResource TextShadow}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-5"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Prize Image - Bên trái giữa (khung xanh 2) -->
            <Image x:Name="imgPrize" 
                   Height="330" 
                   Width="330"
                   Canvas.Left="90"
                   Canvas.Top="300"
                   Stretch="Fill"/>

            <!-- Lộc Xuân 1 -->
            <TextBlock x:Name="txtLoc1" 
                       Text="1 1 1 1" 
                       FontSize="56" 
                       FontWeight="Bold"
                       Foreground="Black"/>

            <!-- Lộc Xuân 2 -->
            <TextBlock x:Name="txtLoc2" 
                       Text="2 2 2 2" 
                       FontSize="56" 
                       FontWeight="Bold"
                       Foreground="Black"/>

            <!-- Lộc Xuân 3 -->
            <TextBlock x:Name="txtLoc3" 
                       Text="3 3 3 3" 
                       FontSize="56" 
                       FontWeight="Bold"
                       Foreground="Black"/>

            <!-- Lộc Xuân 4 -->
            <TextBlock x:Name="txtLoc4" 
                       Text="4 4 4 4" 
                       FontSize="56" 
                       FontWeight="Bold"
                       Foreground="Black"/>

            <!-- 5 Buttons và Text Khuyến Khích -->
            <StackPanel x:Name="spButtons" 
                        Orientation="Horizontal">
                <Button x:Name="btn1" 
                        Content="1" 
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btn2" 
                        Content="2" 
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btn3" 
                        Content="3" 
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Background="#FF9800"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btn4" 
                        Content="4" 
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Background="#E91E63"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btn5" 
                        Content="5" 
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        FontWeight="Bold"
                        Background="#9C27B0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Text Khuyến Khích 1 -->
            <TextBlock x:Name="txtKK" 
                       Text="1111-2222-3333-4444-5555" 
                       FontSize="35" 
                       Margin="45,0,0,0"
                       FontWeight="Bold"
                       Foreground="Black"/>

          
        </Canvas>
    </Grid>
</Window>