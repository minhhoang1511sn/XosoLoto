<Window x:Class="Xosoloto.InitLocXuan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initialize Lucky Draw" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Label Content="Event Title:" FontWeight="Bold" FontSize="14"/>
                <TextBox x:Name="txtTitle" Height="30" FontSize="14"/>
            </StackPanel>

            <!-- Logo Section -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Label Content="Logo:" FontWeight="Bold" FontSize="14"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnAddLogo" Content="Select Logo" Width="100" Height="30" 
                            Margin="0,0,10,0"/>
                    <Border BorderBrush="Gray" BorderThickness="1" Width="150" Height="150">
                        <Image x:Name="imgLogoPreview" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Background Image Section -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <Label Content="Background Image:" FontWeight="Bold" FontSize="14"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnAddImg" Content="Select Background" Width="120" Height="30" 
                            Margin="0,0,10,0"/>
                    <Border BorderBrush="Gray" BorderThickness="1" Width="200" Height="150">
                        <Image x:Name="imgBackgroundPreview" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Prize Images Section -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <Label Content="Prize Images (5 prizes):" FontWeight="Bold" FontSize="14"/>
                <StackPanel>
                    <!-- Prize 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Prize 1:" Width="70" VerticalAlignment="Center"/>
                        <Button x:Name="btnAddPrize1" Content="Select Image" Width="100" Height="30" 
                                Margin="0,0,10,0" Tag="1"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="90">
                            <Image x:Name="imgPrize1Preview" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <!-- Prize 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Prize 2:" Width="70" VerticalAlignment="Center"/>
                        <Button x:Name="btnAddPrize2" Content="Select Image" Width="100" Height="30" 
                                Margin="0,0,10,0" Tag="2"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="90">
                            <Image x:Name="imgPrize2Preview" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <!-- Prize 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Prize 3:" Width="70" VerticalAlignment="Center"/>
                        <Button x:Name="btnAddPrize3" Content="Select Image" Width="100" Height="30" 
                                Margin="0,0,10,0" Tag="3"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="90">
                            <Image x:Name="imgPrize3Preview" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <!-- Prize 4 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Prize 4:" Width="70" VerticalAlignment="Center"/>
                        <Button x:Name="btnAddPrize4" Content="Select Image" Width="100" Height="30" 
                                Margin="0,0,10,0" Tag="4"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="90">
                            <Image x:Name="imgPrize4Preview" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <!-- Prize 5 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Prize 5:" Width="70" VerticalAlignment="Center"/>
                        <Button x:Name="btnAddPrize5" Content="Select Image" Width="100" Height="30" 
                                Margin="0,0,10,0" Tag="5"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="90">
                            <Image x:Name="imgPrize5Preview" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Done Button -->
            <Button x:Name="btnDone" Grid.Row="4" Content="Done" Width="120" Height="40" 
                    FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        </Grid>
    </ScrollViewer>
</Window>