<Window x:Class="Xosoloto.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu"
        Height="520" Width="420"
        MinWidth="340" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Background="#f0f0f0">

    <Viewbox Stretch="Uniform">
    <Grid Width="380" Height="480" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,10,0,10">
            <TextBlock Text="🔑 QUÊN MẬT KHẨU" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#333"/>
            <TextBlock x:Name="txtSubtitle" Text="Nhập tên đăng nhập hoặc email đã đăng ký" FontSize="13"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#777"/>
        </StackPanel>

        <!-- Bước 1: username/email -->
        <StackPanel x:Name="AccountPanel" Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Tên đăng nhập hoặc Email" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <TextBox x:Name="txtAccount" FontSize="16" Padding="8,6"/>
        </StackPanel>

        <!-- Bước 2: OTP -->
        <StackPanel x:Name="OtpPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Mã OTP đã gửi tới email" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <TextBox x:Name="txtOtp" FontSize="16" Padding="8,6" MaxLength="6"/>
            <TextBlock x:Name="txtResendOtp" Text="Gửi lại mã OTP"
                       FontSize="12" Foreground="#1E90FF" Margin="2,6,0,0" Cursor="Hand"
                       TextDecorations="Underline" MouseLeftButtonUp="txtResendOtp_Click"/>
        </StackPanel>

        <!-- Bước 2: Mật khẩu mới -->
        <StackPanel x:Name="NewPasswordPanel" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Mật khẩu mới" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <PasswordBox x:Name="txtNewPassword" FontSize="16" Padding="8,6"/>
        </StackPanel>

        <StackPanel x:Name="ConfirmPasswordPanel" Grid.Row="4" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Xác nhận mật khẩu mới" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <PasswordBox x:Name="txtConfirmNewPassword" FontSize="16" Padding="8,6"/>
        </StackPanel>

        <!-- Thông báo lỗi -->
        <TextBlock x:Name="txtError" Grid.Row="5" Foreground="#D32F2F" FontSize="12"
                   TextWrapping="Wrap" Margin="2,10,2,0" MinHeight="18"/>

        <!-- Nút chính -->
        <Button x:Name="btnSubmit" Grid.Row="6" Content="Gửi mã OTP"
                VerticalAlignment="Top"
                FontSize="17" FontWeight="Bold" Padding="0,12" Margin="0,6,0,0"
                Background="#4CAF50" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="btnSubmit_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#45a049"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Hủy -->
        <Button Grid.Row="7" Content="Hủy" FontSize="13" Padding="20,6"
                HorizontalAlignment="Center" Background="#999" Foreground="White"
                BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#777"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
    </Viewbox>
</Window>
