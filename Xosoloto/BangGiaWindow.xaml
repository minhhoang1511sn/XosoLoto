<Window x:Class="Xosoloto.BangGiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Giá Vé"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1920" Height="1080">
            <Grid.Background>
                <ImageBrush ImageSource="Images/c.png" Stretch="UniformToFill"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <MediaElement x:Name="mediaElement"
                          Grid.RowSpan="3"
                          Grid.ZIndex="-1"
                          Source="Images/media1.mov"
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          IsMuted="True"
                          MediaEnded="MediaElement_MediaEnded"/>

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0" Padding="20,15,20,10">
                <TextBlock Text="LÔTÔ VUI XUÂN"
                           FontSize="100" FontWeight="ExtraBold"
                           FontFamily="/Fonts/#Faustina"
                           Foreground="#FFE800"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- BẢNG CHÍNH -->
            <Border Grid.Row="1" Margin="20,0,20,10" CornerRadius="10" BorderThickness="3">
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="Images/c.png" Stretch="UniformToFill"/>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.8*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="VÒNG&#x0A;LOẠI"
                                   FontSize="28" FontWeight="ExtraBold"
                                   FontFamily="/Fonts/#Faustina"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Padding="10,15"/>
                        <Border Grid.Column="1" BorderThickness="2,0,0,0">
                            <TextBlock Text="MÀU VÉ"
                                       FontSize="28" FontWeight="ExtraBold"
                                       FontFamily="/Fonts/#Faustina"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Padding="10,15"/>
                        </Border>
                        <Border Grid.Column="2" BorderThickness="2,0,0,0">
                            <TextBlock Text="GIÁ TIỀN"
                                       FontSize="28" FontWeight="ExtraBold"
                                       FontFamily="/Fonts/#Faustina"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Padding="10,15"/>
                        </Border>
                        <Border Grid.Column="3" BorderThickness="2,0,0,0"/>
                    </Grid>

                    <!-- DATA ROW -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột 0: số vòng — căn giữa cột, không dùng Margin hack -->
                        <Border Grid.Column="0" BorderThickness="0,0,0,2">
                            <TextBlock x:Name="VongSoTextBlock" Text="01"
                                       FontSize="80" FontWeight="ExtraBold"
                                       FontFamily="/Fonts/#Faustina"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Cột 1: hộp màu vé — Width/Height cố định, căn giữa cột -->
                        <Border Grid.Column="1" BorderThickness="2,0,0,2">
                            <Border x:Name="MauVeDisplayBorder"
                                    Background="#1E6FBF"
                                    Width="300" Height="120"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="8"
                                    BorderBrush="#0A4A8A"
                                    BorderThickness="2"/>
                        </Border>

                        <!-- Cột 2: giá tiền — căn giữa cột -->
                        <Border Grid.Column="2" BorderThickness="2,0,0,2">
                            <TextBlock x:Name="GiaTienTextBlock" Text="10.000"
                                       FontSize="82" FontWeight="ExtraBold"
                                       FontFamily="/Fonts/#Faustina"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="3" BorderThickness="2,0,0,2"/>
                    </Grid>

                    <!-- ĐÃ BÁN ROW — giữ nguyên hoàn toàn -->
                    <Grid x:Name="DaBanGrid" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="0.45*"/>
                            <ColumnDefinition Width="0.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Progress bar -->
                        <Border Grid.Column="1"
                                Padding="30,15,0,15"
                                VerticalAlignment="Center"
                                Height="200"
                                HorizontalAlignment="Stretch">
                            <Border x:Name="ProgressTrack"
                                    CornerRadius="6"
                                    Background="White"
                                    BorderBrush="#333333"
                                    BorderThickness="8"
                                    Padding="5,5,5,5">
                                <UniformGrid x:Name="ProgressGrid" Rows="1" Columns="12">
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell01" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell02" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell03" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell04" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell05" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell06" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell07" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell08" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell09" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell10" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell11" Background="#EEFAEE"/>
                                    <Border Margin="3" CornerRadius="6" x:Name="Cell12" Background="#EEFAEE"/>
                                </UniformGrid>
                            </Border>
                        </Border>

                        <!-- % text -->
                        <TextBlock x:Name="PhanTramTextBlock"
                                   Grid.Column="2"
                                   Text="–"
                                   Margin="-50,0,0,0"
                                   FontSize="120" FontWeight="ExtraBold"
                                   FontFamily="/Fonts/#Faustina"
                                   Foreground="#00AA44"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                </Grid>
            </Border>

            <!-- BOTTOM BAR — giữ nguyên hoàn toàn -->
            <Grid Grid.Row="2" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="◀ Back"
                        Height="35" Padding="12,0"
                        Margin="0,0,15,0"
                        FontSize="14" FontWeight="Bold"
                        Background="#555555" Foreground="White" BorderThickness="0"
                        Click="BackButton_Click"/>

                <TextBlock Grid.Column="1" Text="Vòng loại:"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2"
                          x:Name="VongLoaiSelectComboBox"
                          Height="35" FontSize="14" FontWeight="Bold"
                          SelectionChanged="VongLoaiSelectComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="4" Text="% Vé bán:"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="5"
                         x:Name="PhanTramInputTextBox"
                         Height="35" FontSize="18" FontWeight="Bold"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         PreviewKeyDown="PhanTramInput_PreviewKeyDown"/>
                <Button Grid.Column="6"
                        Content="OK" Height="35" Width="50"
                        Margin="6,0,0,0" FontSize="14" FontWeight="Bold"
                        Background="#1E6FBF" Foreground="White" BorderThickness="0"
                        Click="PhanTramOK_Click"/>

                <Button Grid.Column="7"
                        x:Name="ToggleCellColorButton"
                        Content="🟢 Xanh lá"
                        Height="35" Padding="12,0"
                        Margin="6,0,0,0"
                        Width="80"
                        FontSize="14" FontWeight="Bold"
                        Background="#229900" Foreground="White" BorderThickness="0"
                        Click="ToggleCellColorButton_Click"/>
            </Grid>

        </Grid>
    </Viewbox>

</Window>
