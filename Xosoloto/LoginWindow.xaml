<Window x:Class="Xosoloto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập"
        Height="520" Width="420"
        MinWidth="340" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Background="#f0f0f0">

    <Viewbox Stretch="Uniform">
    <Grid Width="380" Height="480" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,10,0,10">
            <TextBlock Text="🎉 XỔ SỐ LOTO" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#333"/>
            <TextBlock x:Name="txtSubtitle" Text="Đăng nhập để tiếp tục" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#777"/>
        </StackPanel>

        <!-- Tên đăng nhập -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Tên đăng nhập" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <TextBox x:Name="txtUsername" FontSize="16" Padding="8,6"/>
        </StackPanel>

        <!-- Mật khẩu -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <PasswordBox x:Name="txtPassword" FontSize="16" Padding="8,6"/>
        </StackPanel>

        <!-- Xác nhận mật khẩu (chỉ hiện khi đăng ký) -->
        <StackPanel x:Name="ConfirmPasswordPanel" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Xác nhận mật khẩu" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <PasswordBox x:Name="txtConfirmPassword" FontSize="16" Padding="8,6"/>
        </StackPanel>

        <!-- Ghi nhớ đăng nhập -->
        <CheckBox x:Name="chkRemember" Grid.Row="4" Content="Ghi nhớ đăng nhập"
                  FontSize="13" Margin="2,16,0,0" IsChecked="True"/>

        <!-- Thông báo lỗi -->
        <TextBlock x:Name="txtError" Grid.Row="5" Foreground="#D32F2F" FontSize="12"
                   TextWrapping="Wrap" Margin="2,10,2,0" MinHeight="18"/>

        <!-- Nút chính -->
        <Button x:Name="btnSubmit" Grid.Row="6" Content="Đăng nhập"
                FontSize="17" FontWeight="Bold" Padding="0,12" Margin="0,6,0,0"
                Background="#4CAF50" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="btnSubmit_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#45a049"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Chuyển đổi Đăng nhập / Đăng ký -->
        <TextBlock x:Name="txtToggleMode" Grid.Row="7"
                   Text="Chưa có tài khoản? Đăng ký ngay"
                   FontSize="13" Foreground="#1E90FF" HorizontalAlignment="Center"
                   Margin="0,14,0,0" Cursor="Hand"
                   TextDecorations="Underline"
                   MouseLeftButtonUp="txtToggleMode_Click"/>

        <!-- Thoát -->
        <Button Grid.Row="9" Content="Thoát" FontSize="13" Padding="20,6"
                HorizontalAlignment="Center" Background="#999" Foreground="White"
                BorderThickness="0" Cursor="Hand" Click="btnExit_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#777"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
    </Viewbox>
</Window>
