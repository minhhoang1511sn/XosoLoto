<Window x:Class="Xosoloto.LocXuanShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Xosoloto"
        mc:Ignorable="d"
        Title="Lộc Xuân Đầu Năm - Màn hình Trình chiếu"
        Height="900" Width="1600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        Focusable="True"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow"
                          Color="Black"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Opacity="0.8"/>
    </Window.Resources>

    <Grid>
        <!-- ============================================================
             OVERVIEW PANEL: màn hình TỔNG - hiển thị tất cả các giải cùng
             lúc. Đây là chế độ mặc định, dùng khi không có giải nào đang
             được người điều khiển mở để nhập số (PrizeDisplayWindow đóng).
             ============================================================ -->
        <Grid x:Name="OverviewPanel">
            <!-- ============================================================
                 RESPONSIVE LAYOUT: giống hệt LuckyDrawControl.xaml (màn hình
                 Chỉnh sửa) - toàn bộ nội dung vẽ trên 1 canvas ẢO cố định
                 1600x900 (BASE_WIDTH/BASE_HEIGHT), Viewbox co giãn ĐỀU khối
                 này để vừa khít mọi kích thước màn hình/máy chiếu mà KHÔNG
                 làm lệch vị trí tương đối giữa các phần tử (logo, tiêu đề,
                 ảnh giải, ô số...). Phải giữ ĐÚNG các toạ độ này khớp 100%
                 với LuckyDrawControl.xaml để 2 màn hình luôn hiển thị giống
                 nhau. -->
            <Viewbox Stretch="Uniform">
                <Grid Width="1600" Height="900">
                    <Grid.Background>
                        <ImageBrush ImageSource="Images/backgroundlocxuan.png" Stretch="Fill" />
                    </Grid.Background>

                    <Canvas x:Name="MainCanvas" Width="1600" Height="900">
                        <Image x:Name="imgLogo"
                               Height="110"
                               Width="250"
                               Canvas.Left="90"
                               Canvas.Top="180"
                               Stretch="Fill"/>

                        <TextBlock x:Name="txtTitle"
                                   Text="ĐẠI HỘI TẾT 2025"
                                   FontSize="80"
                                   FontWeight="Bold"
                                   Foreground="#FFD700"
                                   FontFamily="/Fonts/#HL-Thufap2-Unicode"
                                   Canvas.Top="175"
                                   TextAlignment="Center"
                                   Effect="{StaticResource TextShadow}">
                            <TextBlock.RenderTransform>
                                <SkewTransform AngleX="-5"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <Image x:Name="imgPrize"
                               Height="330"
                               Width="330"
                               Canvas.Left="90"
                               Canvas.Top="300"
                               Stretch="Fill"/>

                        <!-- Các ô số "Lộc Xuân i" được sinh ĐỘNG trong code-behind, cùng số vòng với
                             LuckyDrawWindow (màn hình Chỉnh sửa), xem LocXuanShowWindow.xaml.cs.
                             Vị trí cũng là toạ độ CỐ ĐỊNH trên canvas 1600x900 (không phụ thuộc
                             ActualWidth/ActualHeight cửa sổ), Viewbox bên ngoài lo co giãn. -->
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ============================================================
             DETAIL PANEL: màn hình CHI TIẾT 1 giải - hiển thị đúng ảnh nền
             DetailsPrize.png + tên giải + số trúng thưởng (cỡ lớn) + ảnh
             giải, khớp 100% bố cục của PrizeDisplayWindow (màn hình Chỉnh
             sửa dùng để nhập số). Được bật lên khi người điều khiển mở 1
             giải cụ thể (PrizeDisplayWindow), và tắt đi (quay lại
             OverviewPanel) khi đóng lại. Xem LuckyDrawWindow.OpenPrizeWindow
             / ShowPrizeOnScreen / ShowOverviewOnScreen.

             Toạ độ dưới đây được ĐO TRỰC TIẾP từ ảnh nền Images/DetailsPrize.png,
             PHẢI giữ giống hệt PrizeDisplayWindow.xaml để 2 màn hình luôn khớp
             nhau (xem giải thích chi tiết ở đó).

             LƯU Ý CANH GIỮA: txtDetailPrizeName / txtDetailNumber được bọc
             trong Border - Border làm chủ Canvas.Left/Top/Width/Height (vị
             trí + kích thước khung), còn TextBlock bên trong chỉ lo canh
             giữa bằng HorizontalAlignment/VerticalAlignment/TextAlignment.
             Đặt các thuộc tính này trực tiếp lên phần tử là CON TRỰC TIẾP
             của Canvas sẽ KHÔNG có tác dụng (Canvas không tự dàn theo
             alignment), đó là lý do bản cũ bị dính chữ vào góc trên-trái.
             ============================================================ -->
        <Viewbox x:Name="DetailPanel" Stretch="Uniform" Visibility="Collapsed">
            <Grid Width="1920" Height="1080">
                <Grid.Background>
                    <ImageBrush x:Name="imgDetailBackground" Stretch="Fill" />
                </Grid.Background>
                <Canvas Width="1920" Height="1080">
                    <!-- Header: Logo + Title -->
                    <Image x:Name="imgDetailLogo" Height="110" Width="250"
                           Canvas.Left="100" Canvas.Top="200" Stretch="Uniform"/>
                    <TextBlock x:Name="txtDetailTitle"
                               Text="ĐẠI HỘI TẾT"
                               FontSize="70"
                               FontWeight="Bold"
                               Foreground="#FFD700"
                               FontFamily="/Fonts/#HL-Thufap2-Unicode"
                               Canvas.Left="390"
                               Canvas.Top="200"
                               Height="110"
                               MaxWidth="1430"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <SkewTransform AngleX="-5"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Nhãn tên giải - khớp dải ruy băng đỏ phía trên khung số. -->
                    <Border Canvas.Left="170"
                            Canvas.Top="425"
                            Width="1000"
                            Height="170">
                        <TextBlock x:Name="txtDetailPrizeName"
                                   Text="LỘC XUÂN"
                                   FontSize="70"
                                   FontWeight="ExtraBold"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>

                    <!-- Số trúng thưởng - khớp khung bo góc màu kem. TextWrapping="Wrap" để
                         giải Khuyến khích (nhiều số, cỡ chữ nhỏ hơn) tự xuống dòng và vẫn
                         canh giữa đúng cả khối theo chiều dọc lẫn ngang. -->
                    <Border Canvas.Left="150"
                            Canvas.Top="615"
                            Width="1055"
                            Height="350">
                        <TextBlock x:Name="txtDetailNumber"
                                   Text="? ? ? ?"
                                   FontSize="180"
                                   FontWeight="Black"
                                   Foreground="Black"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ảnh giải thưởng -->
                    <Viewbox Canvas.Left="1330" Canvas.Top="440" Width="480" Height="480">
                        <Image x:Name="imgDetailPrize" Stretch="Uniform" MaxHeight="350" MaxWidth="350"/>
                    </Viewbox>
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- Thanh trạng thái + nút thoát: LUÔN hiển thị (cả 2 chế độ) để người dùng biết đang
             trình chiếu ở màn hình nào (1 hay 2 màn hình) và luôn có cách thoát khỏi màn hình
             Trình chiếu (không phụ thuộc phím ESC, phòng khi không có bàn phím trong tầm tay). -->
        <Border x:Name="StatusBadge"
                Background="#AA000000"
                CornerRadius="6"
                Padding="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Panel.ZIndex="999">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtMonitorStatus"
                           Text="—"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button x:Name="btnCloseShow"
                        Content="✕ Đóng (ESC)"
                        Padding="10,3"
                        FontSize="13"
                        Click="BtnCloseShow_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
