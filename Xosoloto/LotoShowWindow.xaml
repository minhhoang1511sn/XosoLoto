<Window x:Class="Xosoloto.LotoShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Xosoloto"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        mc:Ignorable="d"
        Title="Xổ Số Loto - Màn hình Trình chiếu"
        Height="450" Width="800"
        Background="Black"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        Focusable="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid>
        <MediaElement x:Name="mediaElement"
                 Grid.ZIndex="-1"
                 Source="Images/media1.mov"
                 Stretch="UniformToFill"
                 LoadedBehavior="Manual"
                 IsMuted="True"
                 MediaEnded="MediaElement_MediaEnded"/>

        <!-- Stretch="UniformToFill" thay vì "Uniform": lấp đầy kín màn hình phụ dù tỉ lệ khung
             hình khác 16:9, chấp nhận cắt bớt rìa ngoài thay vì để lộ viền đen 2 cạnh. -->
        <Viewbox Stretch="UniformToFill">
            <Grid Width="1920" Height="1080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Grid.Background>
                    <ImageBrush ImageSource="Images/nen-01.png" Stretch="Fill" />
                </Grid.Background>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="0.6*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           gif:ImageBehavior.AnimatedSource="Images/image5.gif"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Grid.ZIndex="-1"/>

                    <Grid Grid.Column="1">
                        <Image Source="/Images/HieuNguyenPhoto.png"
                               Stretch="Uniform"
                               Grid.ZIndex="-1" Margin="0,0,0,-7"/>
                    </Grid>

                    <Image Grid.Column="2"
                           gif:ImageBehavior.AnimatedSource="Images/image6.gif"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Grid.ZIndex="-1"/>
                </Grid>

                <Border Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.1*" />
                            <RowDefinition Height="0.8*" />
                            <RowDefinition Height="0.1*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Margin="110,0,0,-5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="VÒNG LOẠI: "
                                               FontWeight="Bold"
                                               FontStyle="Italic"
                                               FontSize="48"
                                               FontFamily="/Fonts/#Faustina"
                                               Foreground="Black" />
                                    <TextBlock FontSize="48" FontFamily="/Fonts/#Faustina"
                                               x:Name="VongLoaiTextBlock" Text="--" FontWeight="Bold" Foreground="Black" />
                                </StackPanel>
                            </Viewbox>

                            <Viewbox Grid.Column="1" Margin="0,0,0,-8"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="MÀU VÉ:"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               Margin="0,10,10,-10"
                                               FontSize="100"
                                               FontFamily="/Fonts/#Faustina"
                                               VerticalAlignment="Center"/>
                                    <Border x:Name="MauVeBorder"
                                            Grid.Column="1"
                                            Width="350"
                                            Height="120"
                                            Margin="0,5,0,0"
                                            Background="LightBlue"
                                            BorderBrush="Black"
                                            BorderThickness="2"
                                            CornerRadius="5"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Viewbox>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Stretch="Uniform" Margin="10, 0, 10, 10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28*"/>
                                        <ColumnDefinition Width="47*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Số Vừa Gọi"
                                               FontFamily="/Fonts/#HL-Thufap2-Unicode"
                                               FontWeight="Normal"
                                               Foreground="Black"
                                               HorizontalAlignment="Left"
                                               Margin="47,5,0,5" Grid.ColumnSpan="2"/>

                                    <Viewbox Grid.Row="1" Margin="0, 5, 0, -10" Height="100" Width="150" Grid.ColumnSpan="2">
                                        <Grid Width="20" Margin="0, -3, 0, 0" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="CurrentNumberTextBlock"
                                                       FontWeight="Normal"
                                                       FontSize="20"
                                                       FontFamily="/Fonts/#Alumni Sans Collegiate One"
                                                       Foreground="Red"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                            <Path x:Name="NumberPath"
                                                  Stroke="White"
                                                  StrokeThickness="0.2"
                                                  Fill="Red"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.RenderTransform>
                                                    <TranslateTransform Y="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Viewbox>

                            <Viewbox Grid.Column="1" Stretch="Uniform" Margin="10, 0, 10, 10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Các Số Đã Gọi"
                                               FontFamily="/Fonts/#HL-Thufap2-Unicode"
                                               FontWeight="Normal"
                                               Foreground="Black"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,-5"/>

                                    <Viewbox Grid.Row="1" Height="100" Stretch="Uniform" Margin="0,0,8.5,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Width="258" Height="150">
                                            <Grid x:Name="HistoryNumberContainer"/>
                                        </ScrollViewer>
                                    </Viewbox>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Thanh trạng thái + nút thoát: LUÔN hiển thị để người dùng biết đang trình chiếu
             ở màn hình nào (1 hay 2 màn hình) và luôn có cách thoát khỏi màn hình Trình chiếu. -->
        <Border x:Name="StatusBadge"
                Background="#AA000000"
                CornerRadius="6"
                Padding="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Panel.ZIndex="999">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtMonitorStatus"
                           Text="—"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button x:Name="btnCloseShow"
                        Content="✕ Đóng (ESC)"
                        Padding="10,3"
                        FontSize="13"
                        Click="BtnCloseShow_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
